# Memo secrets. Never commit. Copied from Med-Sim backend/.env.local on 2026-11-24.
SARVAM_API_KEY=
GROQ_API_KEY=
MURF_API_KEY=
MURF_REGION=
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Telegram: dedicated Memo bot (set once created via BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Twilio caller number (voice-capable) and owner's verified number for dev calls
TWILIO_VOICE_FROM=

DATABASE_URL=postgresql://memo:memo@localhost:5433/memo
APP_SECRET=
PUBLIC_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:5173
STORAGE_DIR=../data/storage
GALLERY_DIR=../data/gallery
LLM_PROVIDER=sarvam
DEFAULT_TZ=Asia/Kolkata

# Flagsmith / NudgeBee: wired later
FLAGSMITH_ENVIRONMENT_KEY=
NUDGEBEE_API_KEY=

# NudgeBee (AI-SRE) Generic Event Webhook: see docs/NUDGEBEE.md. Both unset = integration is a no-op.
NUDGEBEE_WEBHOOK_URL=
NUDGEBEE_TOKEN=
# Optional: label for the environment (default "local"), and queue-backlog alert threshold in minutes (default 10)
MEMO_ENV=
NUDGEBEE_BACKLOG_MIN=

# Deploy (Render): see docs/DEPLOY_RENDER.md. All optional, off by default in dev.
RUN_WORKER_IN_PROCESS=
TELEGRAM_MODE=
TELEGRAM_REGISTER_WEBHOOK=
FLAGSMITH_DB_NAME=
FLAGSMITH_API_URL=
WEB_DIST_DIR=

# Flagsmith (self-hosted): see docs/FLAGSMITH.md. FLAGSMITH_ENVIRONMENT_KEY (above) is the server-side `ser.` key;
# unset = flags come from DB overrides + code defaults. The rest are for the local container and the seed script.
FLAGSMITH_DJANGO_SECRET_KEY=
FLAGSMITH_ADMIN_EMAIL=
FLAGSMITH_ADMIN_PASSWORD=
FLAGSMITH_ADMIN_API_KEY=
FLAGSMITH_PHONE_PILOT_FAMILIES=
